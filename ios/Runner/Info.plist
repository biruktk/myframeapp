			<key>CFBundleTypeName</key>
			<string>Images</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>public.heic</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Mirrors lib/config/vps_defaults.dart production API — Flutter uses that at runtime unless API_BASE dart-define overrides. -->
	<key>MyframeApiBase</key>
	<string>http://128.241.231.234:3001</string>
	<!-- Marketing hostname alternate (same VPS :3001 if DNS resolves). Flutter defaults to raw IP via VpsDefaults.apiBase for reliability. -->
	<key>MyframeInkHost</key>
	<string>http://myframe.ink:3001</string>
	<!--
	  XT ePaper firmware often pulls `http://<VPS-IP>:3001/frame-media/...`.
	  NSAllowsLocalNetworking alone does NOT allow HTTP to a public WAN IP — only LAN-style uses.
	  NSAllowsArbitraryLoads enables `API_BASE=http://128.x.x.x:3001` from a real iPhone.
	  Prefer HTTPS + domain exception for production / App Store if you tighten ATS later.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
